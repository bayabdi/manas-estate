# Local development defaults; never commit real secrets in .env
APP_ENV=development
ALLOW_INSECURE_DEV_AUTH=1
DATABASE_URL=sqlite:///data/manas.db
SECRET_KEY=change-me-in-render
ADMIN_USERNAME=admin
# Generate with: python -m app.main hash-password 'your-password'
ADMIN_PASSWORD_HASH=
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
